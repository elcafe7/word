{
  "name": "word",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Word: scripture one word at a time (RSVP) in the browser, online or offline",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "data": "python3 scripts/build_data.py",
    "offline": "bash scripts/build-offline.sh",
    "e2e:offline": "playwright test -c playwright.offline.config.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jsdom": "27.4.0",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  }
}
